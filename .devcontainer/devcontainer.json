// GitHub Codespaces and local dev containers: installs both toolchains and starts the browser demo
// (`uv run python demo.py --browser`) on every start. Its output is in /tmp/muxws-demo.log.
{
  "name": "muxws demo",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2 },
  // MUXWS_DEMO_VITE_HOST: Vite listens on all interfaces; `localhost` resolves to `::1` only in the container.
  // UV_LINK_MODE: the uv cache and the workspace are on different filesystems, so uv copies instead of
  // hard-linking.
  "containerEnv": { "UV_LINK_MODE": "copy", "MUXWS_DEMO_VITE_HOST": "1" },
  "postCreateCommand": "pipx install uv && uv sync --locked && npm ci",
  "postStartCommand": "nohup uv run python demo.py --browser > /tmp/muxws-demo.log 2>&1 &",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Demo frontend", "onAutoForward": "openBrowser" },
    "8020": { "label": "Demo backend", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python" }
    }
  }
}
