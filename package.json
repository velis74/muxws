{
  "name": "muxws",
  "private": false,
  "version": "0.4.4",
  "type": "module",
  "sideEffects": false,
  "description": "Multiplexed, cancellable, bidirectional streams over one WebSocket",
  "author": "Jure Erznožnik",
  "files": [
    "dist/*"
  ],
  "main": "dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./msgpack": {
      "import": {
        "types": "./dist/msgpack.d.ts",
        "default": "./dist/msgpack.js"
      },
      "require": {
        "types": "./dist/msgpack.d.cts",
        "default": "./dist/msgpack.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/node.d.ts"
      ],
      "msgpack": [
        "./dist/msgpack.d.ts"
      ]
    }
  },
  "workspaces": [
    "docs",
    "demo/frontend"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "eslint ts interop demo/frontend/src demo/backend_node --fix && markdownlint-cli2 --fix '**/*.md' && tsc --noEmit && tsc -p interop/tsconfig.json && tsc -p demo/backend_node/tsconfig.json",
    "lint:ci": "eslint ts interop demo/frontend/src demo/backend_node && markdownlint-cli2 '**/*.md' && tsc --noEmit && tsc -p interop/tsconfig.json && tsc -p demo/backend_node/tsconfig.json",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs",
    "docs:check": "node docs/check-docs.mjs",
    "types:check": "node scripts/check-package-types.mjs",
    "demo:dev": "npm run dev -w demo-frontend",
    "demo:backend:node": "tsx demo/backend_node/main.ts"
  },
  "keywords": [
    "websocket",
    "multiplexing",
    "streams"
  ],
  "license": "MIT",
  "homepage": "https://docs.velis.si/muxws/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velis74/muxws.git"
  },
  "bugs": {
    "url": "https://github.com/velis74/muxws/issues"
  },
  "peerDependencies": {
    "@msgpack/msgpack": "^3",
    "ws": "^8"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    },
    "@msgpack/msgpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3",
    "@types/node": "^24",
    "@types/ws": "^8",
    "@vitest/coverage-v8": "^3",
    "eslint-config-velis": "^2.0.12",
    "jsdom": "^26.0.0",
    "markdownlint-cli2": "^0.18.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vite": "^8",
    "vite-plugin-dts": "^5",
    "vitest": "^3",
    "ws": "^8"
  }
}
