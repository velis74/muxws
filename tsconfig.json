{
  "extends": "./node_modules/eslint-config-velis/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "paths": { "@/*": ["./ts/*"] },
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true
  },
  // `interop/` is Node ESM (`import.meta.url`) and has its own `interop/tsconfig.json`; the lint
  // scripts check both.
  "include": ["ts/**/*"],
  "exclude": [".venv", "dist", "coverage", "node_modules", "docs", "muxws"]
}
