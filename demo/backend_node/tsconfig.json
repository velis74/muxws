{
  // The node backend is Node ESM (`demo.py --browser node` runs it under tsx); the root config
  // compiles to CommonJS, one of the library's two build targets. `interop/tsconfig.json` overrides the
  // root config in the same way, so the root config stays unchanged for the library.
  //
  // The root config includes only `ts/**/*`, so the root `tsc --noEmit` does not check this directory.
  // `npm run lint:ci` runs `tsc -p` against this config, and `eslint.config.js` uses it for the typed
  // lint rules; both must reference this file.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
